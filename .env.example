# Copy this file to .env for local testing (fly.io uses `fly secrets set` instead — see README).

# Required — from https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — override the model used for answering questions
ANTHROPIC_MODEL=claude-sonnet-5

# Required — the one passcode all front desk / leadership staff will type in to open the chat
STAFF_PASSCODE=change-me

# Required — the password managers use to reach /admin and edit the knowledge base
ADMIN_PASSWORD=change-me-too

# Required — a long random string used to sign login cookies so they can't be forged.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional — where the knowledge base JSON + uploaded flyers are stored.
# On Fly.io this should point at your mounted volume (see fly.toml). Defaults to ./data
DATA_DIR=./data

# Optional — port the server listens on. Fly.io sets this automatically; only needed locally.
PORT=8080
